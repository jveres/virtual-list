{
  "name": "virtual-list",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run check && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/browser-matrix.mjs",
    "profile:firefox": "node scripts/firefox-profile.mjs",
    "test:firefox-profile": "node --test scripts/firefox-profile/analyze.checks.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^26.4.1",
    "jsdom": "^30.0.1",
    "katex": "^0.18.5",
    "markdown-viewer": "github:jveres/markdown-viewer#v0.1.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
