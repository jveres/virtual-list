{
  "name": "virtual-list",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run check && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit",
    "test": "vitest run",
    "test:consumer": "node scripts/check-consumer.mjs",
    "test:browser": "node scripts/browser-matrix.mjs",
    "test:regression": "node scripts/regression-suite.mjs",
    "test:regression-runner": "node --test scripts/regression-suite.checks.mjs",
    "test:chat-tree": "node scripts/regression-suite.mjs --group=chat-tree",
    "profile:firefox": "node scripts/firefox-profile.mjs",
    "test:firefox-profile": "node --test scripts/firefox-profile/*.checks.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.2",
    "jsdom": "^30.1.0",
    "katex": "^0.18.7",
    "markdown-viewer": "github:jveres/markdown-viewer#v0.5.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
